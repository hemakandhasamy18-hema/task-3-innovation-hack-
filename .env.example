# Application Port & Environment
PORT=4000
NODE_ENV=development

# PostgreSQL Connection String (Prisma format)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/developer_productivity_db?schema=public"

# JWT Authentication Secrets & Expiry
JWT_SECRET="super-secret-developer-productivity-jwt-key-change-in-production-2026"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origin
CORS_ORIGIN="*"

# Logging Level (debug, info, warn, error)
LOG_LEVEL="debug"
